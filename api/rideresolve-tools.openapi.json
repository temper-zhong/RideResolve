{
  "openapi": "3.0.3",
  "info": {
    "title": "RideResolve Gate A Probe Tools",
    "version": "0.2.3",
    "description": "Read-only tools for synthetic RideResolve cases. The secure connector credential is a short-lived, role-specific run token and must never appear in model input."
  },
  "servers": [
    {
      "url": "https://rideresolve-gate-a-probe-325140-12-1501522460.sh.run.tcloudbase.com"
    }
  ],
  "paths": {
    "/tools/get_case_snapshot": {
      "post": {
        "operationId": "get_case_snapshot",
        "summary": "Get the case summary authorized for this probe run",
        "description": "Use first. Evidence IDs are intentionally omitted so evidence citations must come from get_trip_evidence.",
        "security": [
          {
            "RunToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful run-scoped tool response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "result",
                    "request_id"
                  ],
                  "properties": {
                    "result": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "run_id",
                        "tool_actor_role",
                        "dataset_id",
                        "synthetic",
                        "case",
                        "evidence_reference_count",
                        "available_evidence_types"
                      ],
                      "properties": {
                        "run_id": {
                          "type": "string"
                        },
                        "tool_actor_role": {
                          "type": "string",
                          "enum": [
                            "RIDER_ADVOCATE",
                            "DRIVER_ADVOCATE",
                            "JUDGE"
                          ]
                        },
                        "dataset_id": {
                          "type": "string"
                        },
                        "synthetic": {
                          "type": "boolean"
                        },
                        "case": {
                          "type": "object",
                          "additionalProperties": true,
                          "required": [
                            "case_id",
                            "case_version",
                            "dispute_type",
                            "policy_version",
                            "currency",
                            "claim_text"
                          ],
                          "properties": {
                            "case_id": {
                              "type": "string"
                            },
                            "case_version": {
                              "type": "integer"
                            },
                            "dispute_type": {
                              "type": "string"
                            },
                            "policy_version": {
                              "type": "string"
                            },
                            "currency": {
                              "type": "string"
                            },
                            "trip_started_at": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "trip_ended_at": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "claim_text": {
                              "type": "string"
                            },
                            "disputed_fee_item": {
                              "type": "string"
                            },
                            "disputed_amount_cents": {
                              "type": "integer"
                            },
                            "created_at": {
                              "type": "string",
                              "format": "date-time"
                            }
                          }
                        },
                        "evidence_reference_count": {
                          "type": "integer"
                        },
                        "available_evidence_types": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "PLATFORM_GPS",
                              "FARE_LEDGER",
                              "ROUTE_BASELINE",
                              "TRIP_EVENT_LOG",
                              "CONTACT_LOG",
                              "AUTHENTICATED_CHAT",
                              "DEMO_TRAFFIC_FEED",
                              "PARTY_STATEMENT"
                            ]
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tools/get_trip_evidence": {
      "post": {
        "operationId": "get_trip_evidence",
        "summary": "Get selected evidence authorized for this probe run",
        "description": "Returns only evidence in the server-side run manifest. Prefer SUMMARY unless raw GPS samples are necessary.",
        "security": [
          {
            "RunToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_types"
                ],
                "properties": {
                  "evidence_types": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "enum": [
                        "PLATFORM_GPS",
                        "FARE_LEDGER",
                        "ROUTE_BASELINE",
                        "TRIP_EVENT_LOG",
                        "CONTACT_LOG",
                        "AUTHENTICATED_CHAT",
                        "DEMO_TRAFFIC_FEED",
                        "PARTY_STATEMENT"
                      ]
                    }
                  },
                  "detail": {
                    "type": "string",
                    "enum": [
                      "SUMMARY",
                      "FULL"
                    ],
                    "default": "SUMMARY"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful run-scoped tool response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "result",
                    "request_id"
                  ],
                  "properties": {
                    "result": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "run_id",
                        "tool_actor_role",
                        "dataset_id",
                        "synthetic",
                        "case_id",
                        "case_version",
                        "detail",
                        "evidence"
                      ],
                      "properties": {
                        "run_id": {
                          "type": "string"
                        },
                        "tool_actor_role": {
                          "type": "string",
                          "enum": [
                            "RIDER_ADVOCATE",
                            "DRIVER_ADVOCATE",
                            "JUDGE"
                          ]
                        },
                        "dataset_id": {
                          "type": "string"
                        },
                        "synthetic": {
                          "type": "boolean"
                        },
                        "case_id": {
                          "type": "string"
                        },
                        "case_version": {
                          "type": "integer"
                        },
                        "detail": {
                          "type": "string",
                          "enum": [
                            "SUMMARY",
                            "FULL"
                          ]
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "evidence_id",
                              "source_record_id",
                              "source_type",
                              "trust_tier",
                              "observed_at",
                              "collected_at",
                              "record_role",
                              "related_evidence_ids",
                              "payload",
                              "checksum_verified"
                            ],
                            "properties": {
                              "evidence_id": {
                                "type": "string"
                              },
                              "source_record_id": {
                                "type": "string"
                              },
                              "source_type": {
                                "type": "string",
                                "enum": [
                                  "PLATFORM_GPS",
                                  "FARE_LEDGER",
                                  "ROUTE_BASELINE",
                                  "TRIP_EVENT_LOG",
                                  "CONTACT_LOG",
                                  "AUTHENTICATED_CHAT",
                                  "DEMO_TRAFFIC_FEED",
                                  "PARTY_STATEMENT"
                                ]
                              },
                              "trust_tier": {
                                "type": "string"
                              },
                              "observed_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "collected_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "coverage": {
                                "type": "object",
                                "nullable": true,
                                "additionalProperties": false,
                                "properties": {
                                  "start_at": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "end_at": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "is_complete": {
                                    "type": "boolean"
                                  },
                                  "scope": {
                                    "type": "string"
                                  }
                                }
                              },
                              "record_role": {
                                "type": "string"
                              },
                              "related_evidence_ids": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "provenance_reason": {
                                "type": "string",
                                "nullable": true
                              },
                              "payload": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "samples": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "timestamp": {
                                          "type": "string",
                                          "format": "date-time"
                                        },
                                        "latitude": {
                                          "type": "number"
                                        },
                                        "longitude": {
                                          "type": "number"
                                        }
                                      }
                                    }
                                  },
                                  "sample_count": {
                                    "type": "integer"
                                  },
                                  "first_sample_at": {
                                    "type": "string",
                                    "format": "date-time",
                                    "nullable": true
                                  },
                                  "last_sample_at": {
                                    "type": "string",
                                    "format": "date-time",
                                    "nullable": true
                                  },
                                  "arrival_distance_m": {
                                    "type": "number"
                                  },
                                  "baseline_distance_m": {
                                    "type": "number"
                                  },
                                  "currency": {
                                    "type": "string"
                                  },
                                  "line_items": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "fee_item": {
                                          "type": "string"
                                        },
                                        "amount_cents": {
                                          "type": "integer"
                                        }
                                      }
                                    }
                                  },
                                  "total_paid_cents": {
                                    "type": "integer"
                                  },
                                  "messages": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "tag": {
                                          "type": "string"
                                        },
                                        "text": {
                                          "type": "string"
                                        },
                                        "at": {
                                          "type": "string",
                                          "format": "date-time"
                                        }
                                      }
                                    }
                                  },
                                  "events": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "type": {
                                          "type": "string"
                                        },
                                        "relevant": {
                                          "type": "boolean"
                                        },
                                        "at": {
                                          "type": "string",
                                          "format": "date-time"
                                        }
                                      }
                                    }
                                  },
                                  "attempts": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "channel": {
                                          "type": "string"
                                        },
                                        "at": {
                                          "type": "string",
                                          "format": "date-time"
                                        }
                                      }
                                    }
                                  },
                                  "arrived_at": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "cancelled_at": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "cancelled_by": {
                                    "type": "string"
                                  },
                                  "claims_oral_stop_request": {
                                    "type": "boolean"
                                  }
                                }
                              },
                              "checksum_verified": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "gps_aggregate": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "coverage_percent",
                            "actual_distance_m",
                            "conflict",
                            "conflict_reasons"
                          ],
                          "properties": {
                            "coverage_percent": {
                              "type": "number"
                            },
                            "actual_distance_m": {
                              "type": "number"
                            },
                            "conflict": {
                              "type": "boolean"
                            },
                            "conflict_reasons": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tools/get_policy_rules": {
      "post": {
        "operationId": "get_policy_rules",
        "summary": "Get policy rules authorized for this probe run",
        "description": "The policy version and dispute type come from the server-side run manifest.",
        "security": [
          {
            "RunToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful run-scoped tool response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "result",
                    "request_id"
                  ],
                  "properties": {
                    "result": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "run_id",
                        "tool_actor_role",
                        "policy_id",
                        "policy_version",
                        "effective_from",
                        "timezone",
                        "rules"
                      ],
                      "properties": {
                        "run_id": {
                          "type": "string"
                        },
                        "tool_actor_role": {
                          "type": "string",
                          "enum": [
                            "RIDER_ADVOCATE",
                            "DRIVER_ADVOCATE",
                            "JUDGE"
                          ]
                        },
                        "policy_id": {
                          "type": "string"
                        },
                        "policy_version": {
                          "type": "string"
                        },
                        "effective_from": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "effective_to": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },
                        "timezone": {
                          "type": "string"
                        },
                        "rules": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true,
                            "required": [
                              "rule_id",
                              "dispute_type",
                              "priority",
                              "evaluator"
                            ],
                            "properties": {
                              "rule_id": {
                                "type": "string"
                              },
                              "dispute_type": {
                                "type": "string"
                              },
                              "priority": {
                                "type": "integer"
                              },
                              "evaluator": {
                                "type": "string"
                              },
                              "parameters": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "minimum_gps_coverage_percent": {
                                    "type": "number"
                                  },
                                  "required_source_types": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  },
                                  "maximum_allowed_ratio": {
                                    "type": "number"
                                  },
                                  "verifiable_exception_sources": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  },
                                  "fee_item": {
                                    "type": "string"
                                  },
                                  "maximum_pickup_distance_m": {
                                    "type": "number"
                                  },
                                  "minimum_wait_seconds": {
                                    "type": "integer"
                                  },
                                  "maximum_time_conflict_seconds": {
                                    "type": "integer"
                                  },
                                  "maximum_position_conflict_m": {
                                    "type": "number"
                                  }
                                }
                              },
                              "allowed_outcome": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "business_status": {
                                    "type": "string"
                                  },
                                  "action": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "RunToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-RideResolve-Run-Token",
        "description": "Short-lived role-specific credential configured only in the connector secret store."
      }
    }
  }
}
