{
  "openapi": "3.0.3",
  "info": {
    "title": "RideResolve Driver Tools v0.6",
    "version": "0.6.0",
    "description": "Role-isolated tools for a server-created workflow session. The static connector credential authenticates the role; the signed run_context locks the official case, case version, policy version, expiry, and request budget."
  },
  "servers": [
    {
      "url": "https://rideresolve-gate-a-probe-325140-12-1501522460.sh.run.tcloudbase.com"
    }
  ],
  "paths": {
    "/tools/get_trip_evidence": {
      "post": {
        "operationId": "get_trip_evidence",
        "summary": "Get selected evidence authorized for this probe run",
        "description": "Returns only evidence in the server-side run manifest. Prefer DECISION_FACTS; request SUMMARY or FULL only for human audit.",
        "security": [
          {
            "ConnectorToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run_context",
                  "evidence_types"
                ],
                "properties": {
                  "evidence_types": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "enum": [
                        "PLATFORM_GPS",
                        "FARE_LEDGER",
                        "ROUTE_BASELINE",
                        "TRIP_EVENT_LOG",
                        "CONTACT_LOG",
                        "AUTHENTICATED_CHAT",
                        "DEMO_TRAFFIC_FEED",
                        "PARTY_STATEMENT",
                        "HISTORICAL_BEHAVIOR_PROFILE",
                        "SURGE_PRICING_LOG",
                        "NOTIFICATION_LOG"
                      ]
                    }
                  },
                  "detail": {
                    "type": "string",
                    "enum": [
                      "DECISION_FACTS",
                      "SUMMARY",
                      "FULL"
                    ],
                    "default": "DECISION_FACTS"
                  },
                  "run_context": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2048,
                    "description": "Opaque signed context returned by resolve_case_context. Pass it unchanged; never ask a model to create or edit it."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful run-scoped tool response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "result",
                    "request_id"
                  ],
                  "properties": {
                    "result": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "run_id",
                        "tool_actor_role",
                        "dataset_id",
                        "synthetic",
                        "case_id",
                        "case_version",
                        "detail",
                        "evidence"
                      ],
                      "properties": {
                        "run_id": {
                          "type": "string"
                        },
                        "tool_actor_role": {
                          "type": "string",
                          "enum": [
                            "EVIDENCE_COLLECTION",
                            "RIDER_ADVOCATE",
                            "DRIVER_ADVOCATE",
                            "POLICY_PRECEDENT",
                            "JUDGE"
                          ]
                        },
                        "dataset_id": {
                          "type": "string"
                        },
                        "synthetic": {
                          "type": "boolean"
                        },
                        "case_origin": {
                          "type": "string",
                          "enum": [
                            "OFFICIAL_HACKATHON_SAMPLE",
                            "SYNTHETIC_DEMO",
                            "INTERNAL_TEST_FIXTURE"
                          ]
                        },
                        "case_id": {
                          "type": "string"
                        },
                        "case_version": {
                          "type": "integer"
                        },
                        "detail": {
                          "type": "string",
                          "enum": [
                            "DECISION_FACTS",
                            "SUMMARY",
                            "FULL"
                          ]
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "evidence_id",
                              "source_type",
                              "trust_tier",
                              "coverage",
                              "record_role",
                              "payload",
                              "checksum_verified"
                            ],
                            "properties": {
                              "evidence_id": {
                                "type": "string"
                              },
                              "source_record_id": {
                                "type": "string"
                              },
                              "source_type": {
                                "type": "string",
                                "enum": [
                                  "PLATFORM_GPS",
                                  "FARE_LEDGER",
                                  "ROUTE_BASELINE",
                                  "TRIP_EVENT_LOG",
                                  "CONTACT_LOG",
                                  "AUTHENTICATED_CHAT",
                                  "DEMO_TRAFFIC_FEED",
                                  "PARTY_STATEMENT",
                                  "HISTORICAL_BEHAVIOR_PROFILE",
                                  "SURGE_PRICING_LOG",
                                  "NOTIFICATION_LOG"
                                ]
                              },
                              "trust_tier": {
                                "type": "string"
                              },
                              "observed_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "collected_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "coverage": {
                                "type": "object",
                                "nullable": true,
                                "additionalProperties": false,
                                "properties": {
                                  "start_at": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "end_at": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "is_complete": {
                                    "type": "boolean"
                                  },
                                  "scope": {
                                    "type": "string"
                                  }
                                }
                              },
                              "record_role": {
                                "type": "string"
                              },
                              "related_evidence_ids": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "provenance_reason": {
                                "type": "string",
                                "nullable": true
                              },
                              "payload": {
                                "type": "object",
                                "additionalProperties": true,
                                "properties": {
                                  "samples": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "timestamp": {
                                          "type": "string",
                                          "format": "date-time"
                                        },
                                        "latitude": {
                                          "type": "number"
                                        },
                                        "longitude": {
                                          "type": "number"
                                        }
                                      }
                                    }
                                  },
                                  "sample_count": {
                                    "type": "integer"
                                  },
                                  "first_sample_at": {
                                    "type": "string",
                                    "format": "date-time",
                                    "nullable": true
                                  },
                                  "last_sample_at": {
                                    "type": "string",
                                    "format": "date-time",
                                    "nullable": true
                                  },
                                  "arrival_distance_m": {
                                    "type": "number"
                                  },
                                  "reported_actual_distance_m": {
                                    "type": "number"
                                  },
                                  "baseline_distance_m": {
                                    "type": "number"
                                  },
                                  "currency": {
                                    "type": "string"
                                  },
                                  "line_items": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "fee_item": {
                                          "type": "string"
                                        },
                                        "amount_cents": {
                                          "type": "integer"
                                        }
                                      }
                                    }
                                  },
                                  "total_paid_cents": {
                                    "type": "integer"
                                  },
                                  "messages": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "tag": {
                                          "type": "string"
                                        },
                                        "text": {
                                          "type": "string"
                                        },
                                        "at": {
                                          "type": "string",
                                          "format": "date-time"
                                        }
                                      }
                                    }
                                  },
                                  "events": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "type": {
                                          "type": "string"
                                        },
                                        "relevant": {
                                          "type": "boolean"
                                        },
                                        "at": {
                                          "type": "string",
                                          "format": "date-time"
                                        }
                                      }
                                    }
                                  },
                                  "attempts": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "channel": {
                                          "type": "string"
                                        },
                                        "at": {
                                          "type": "string",
                                          "format": "date-time"
                                        }
                                      }
                                    }
                                  },
                                  "arrived_at": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "cancelled_at": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "cancelled_by": {
                                    "type": "string"
                                  },
                                  "claims_oral_stop_request": {
                                    "type": "boolean"
                                  },
                                  "decision_use": {
                                    "type": "string"
                                  },
                                  "profiles": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "party": {
                                          "type": "string"
                                        },
                                        "account_age_days": {
                                          "type": "integer"
                                        },
                                        "completed_trips": {
                                          "type": "integer"
                                        },
                                        "prior_disputes_180d": {
                                          "type": "integer"
                                        },
                                        "rating_pattern": {
                                          "type": "string"
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              "checksum_verified": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "gps_aggregate": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "coverage_percent",
                            "actual_distance_m",
                            "unique_sample_count",
                            "conflict",
                            "conflict_reasons"
                          ],
                          "properties": {
                            "coverage_percent": {
                              "type": "number"
                            },
                            "actual_distance_m": {
                              "type": "number"
                            },
                            "unique_sample_count": {
                              "type": "integer"
                            },
                            "conflict": {
                              "type": "boolean"
                            },
                            "conflict_reasons": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ConnectorToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-RideResolve-Run-Token",
        "description": "Static, role-specific connector secret. It is expiry-bounded and stored only in ADP connector authentication settings."
      }
    }
  }
}
